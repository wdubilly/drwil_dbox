#!/bin/sh
# Conduct (AGENTS.md): refuses any commit whose message carries a "Co-Authored-By"
# line (some AI tools add it by default). Shipped but DISABLED by default (the
# project chooses): this file is not made executable by `init` — enable it with:
#   chmod +x .githooks/commit-msg
# Can be bypassed with --no-verify, like any local hook.
if grep -qiE '^[[:space:]]*co-authored-by[[:space:]]*:' "$1"; then
  echo "[commit-msg] refusé : retirer la ligne « Co-Authored-By » du message / refused: remove the \"Co-Authored-By\" line from the message (AGENTS.md)." >&2
  exit 1
fi
